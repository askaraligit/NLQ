# Docker Compose provisioning only. Never pass this file to the API or frontend.
# Run scripts/setup.ps1 to generate a random local PostgreSQL password.
POSTGRES_DB=nlq
POSTGRES_USER=nlq_bootstrap
POSTGRES_PASSWORD=

# Published ports bind to 127.0.0.1 only.
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
