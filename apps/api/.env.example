# This file is loaded relative to apps/api, independent of the working directory.
APP_ENV=development
LOG_LEVEL=INFO
# JSON array of exact browser origins. Wildcards and URL paths are rejected.
CORS_ORIGINS=["http://localhost:3000"]

# Database runtime credentials are created by the local bootstrap workflow.
# Host connections will use localhost; Compose connections will use postgres.
# Do not supply migration/bootstrap credentials to the API.
DATABASE_URL=
ANALYTICS_DATABASE_URL=
# Compose overrides these host/port values so browser-host URLs remain valid inside containers.
DATABASE_HOST=
DATABASE_PORT=
ANALYTICS_DATABASE_HOST=
ANALYTICS_DATABASE_PORT=
# Each engine has its own bounded connection pool. URLs must use nlq_app and nlq_reader.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
# Provider, model, and execution limits are set in app/core/provider_config.py.
# Keep only credentials here.
LLM_API_KEY=
NVIDIA_API_KEY=
JWT_SECRET=
JWT_ISSUER=nlq-api
JWT_AUDIENCE=nlq-web
JWT_ACCESS_TOKEN_MINUTES=60
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_ENCRYPTION_KEY=
REDIS_URL=

# Query execution limits.
QUERY_TIMEOUT_MS=10000
QUERY_MAX_ROWS=1000
QUERY_PAGE_SIZE=100
QUERY_MAX_RESPONSE_BYTES=5242880
NLQ_SCHEMA_MAX_TABLES=6
CONVERSATION_MAX_TURNS=4
