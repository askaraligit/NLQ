# This file is loaded relative to apps/api, independent of the working directory.
APP_ENV=development
LOG_LEVEL=INFO
# JSON array of exact browser origins. Wildcards and URL paths are rejected.
CORS_ORIGINS=["http://localhost:3000"]

# Phase 2: python -m app.db.configure fills missing role-specific database URLs.
# The API starts opening database connections in Phase 3; provider settings remain optional.
# Host connections will use localhost; Compose connections will use postgres.
# Do not supply migration/bootstrap credentials to the API.
DATABASE_URL=
ANALYTICS_DATABASE_URL=
# Compose overrides these host/port values so browser-host URLs remain valid inside containers.
DATABASE_HOST=
DATABASE_PORT=
ANALYTICS_DATABASE_HOST=
ANALYTICS_DATABASE_PORT=
# Each engine has its own bounded connection pool. URLs must use nlq_app and nlq_reader.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
JWT_SECRET=
JWT_ISSUER=nlq-api
JWT_AUDIENCE=nlq-web
REDIS_URL=

# Prepared query execution limits for the secured NLQ pipeline in Phase 4.
QUERY_TIMEOUT_MS=10000
QUERY_MAX_ROWS=1000
QUERY_PAGE_SIZE=100
QUERY_MAX_RESPONSE_BYTES=5242880
